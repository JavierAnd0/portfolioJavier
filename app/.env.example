# ==========================================
# RESEND EMAIL CONFIGURATION (Persona Portfolio)
# ==========================================
# Consigue tu API Key gratuita en https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Correo de destino donde Javier recibirá los mensajes del formulario
RESEND_TO_EMAIL=logijavier@gmail.com

# Remitente (puedes usar onboarding@resend.dev para pruebas gratuitas sin configurar dominio)
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Opcional: URL personalizada para la API si despliegas el backend por separado
# VITE_CONTACT_API_URL=/api/send
